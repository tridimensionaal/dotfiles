{
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock", "idle_inhibitor"],
    "modules-right": ["network", "wireplumber#sink", "wireplumber#source", "battery", "custom/power"],

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "network": {
        "interface": "wlp*",
        "format-wifi": "{essid} ",
        "format-disconnected": "Offline",
        "max-length": 24,
        "tooltip": false,
        "on-click": "nm-connection-editor",
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "clock": {
        "format": "{:%Y-%m-%d %R}",
        "tooltip": false,
        "on-click": "gnome-calendar"
    },
    "wireplumber#sink": {
        "format": "{volume}% {icon}",
        "format-muted": "Muted ",
        "format-icons": ["", "", ""],
        "scroll-step": 5,
        "max-volume": 150,
        "tooltip": false,
        "on-click": "pavucontrol",
    },
    "wireplumber#source": {
        "node-type": "Audio/Source",
        "format": "{volume}% ",
        "format-muted": "Mic ",
        "scroll-step": 5,
        "max-volume": 150,
        "tooltip": false,
        "on-click": "pavucontrol",
    },
    "battery": {
        "bat": "BAT0",
        "adapter": "AC",
        "full-at": 100,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false,
        "on-click": "gnome-power-statistics",
    },
	"custom/power": {
		"format": "",
		"tooltip": false,
		"on-click": "wlogout"
    }
}
